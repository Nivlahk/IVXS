{
  "name": "ivxs-desktop",
  "version": "1.0.0",
  "description": "IVX — Visual Programming Language",
  "author": "Nivlahk",
  "repository": "https://github.com/Nivlahk/IVXS",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --mac --win --linux"
  },
  "build": {
    "appId": "tech.ivxs.desktop",
    "productName": "IVXS",
    "copyright": "Copyright © 2026 IVXS Tech",
    "files": [
      "*.js",
      "*.html",
      "*.css",
      "*.png",
      "*.svg",
      "assets/**/*",
      "!sync.ps1",
      "!README.md"
    ],
    "win": {
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github"
    },
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.0.0"
  }
}
